{
  "name": "tphp/teb",
  "version": "0.1.0",
  "type": "ext",
  "license": "MIT",
  "ext": {
    "sources": ["src", "civetweb"],
    "include": ["."],
    "init": "tphp_ext_tphp_teb_init",
    "defines": [
      "OPENSSL_API_3_0",
      "USE_WEBSOCKET",
      "USE_IPV6",
      "USE_SERVER_STATS"
    ],
    "cflags": ["-w"],
    "os": {
      "windows": {
        "cflags": [],
        "libs": ["-lwinpthread"],
        "ldflags": []
      },
      "linux": {
        "cflags": ["-DUSE_ZLIB"],
        "libs": ["-lz"],
        "ldflags": []
      },
      "darwin": {
        "cflags": ["-DUSE_ZLIB"],
        "libs": ["-lz"],
        "ldflags": []
      }
    },
    "tphp_abi": "0.0.2"
  }
}
